# Kopieren nach .env (ist in .gitignore) und ausfuellen. Wird von
# docker-compose.yml an den Container gegeben; config/*.yaml kann die Werte
# als ${NAME} benutzen.

# Pflicht fuer "archivlotse serve": jeder Webhook-Aufruf muss diesen Token
# mitschicken (Header "Authorization: Bearer <token>" oder
# "X-Archivlotse-Token: <token>"). Erzeugen z.B. mit: openssl rand -hex 32
ARCHIVLOTSE_WEBHOOK_TOKEN=

PAPERLESS_TOKEN=
SCALEWAY_SECRET_KEY=

# Optional
# TZ=Europe/Berlin
# ARCHIVLOTSE_PORT=8080
# ARCHIVLOTSE_LOG_LEVEL=INFO
